{
    "swagger": "2.0",
    "info": {
        "description": "Real-time energy event processing — ingest meter readings and detect imbalance alerts.",
        "title": "signalFlow API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/alerts": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "alerts"
                ],
                "summary": "List imbalance alerts",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Filter by asset UUID",
                        "name": "asset_id",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/models.Alert"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/assets": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "assets"
                ],
                "summary": "Create an asset",
                "parameters": [
                    {
                        "description": "Asset to create",
                        "name": "asset",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.CreateAssetRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/models.Asset"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/handlers.healthResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/handlers.healthResponse"
                        }
                    }
                }
            }
        },
        "/readings": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "tags": [
                    "readings"
                ],
                "summary": "Submit a meter reading",
                "parameters": [
                    {
                        "description": "Meter reading",
                        "name": "reading",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/models.CreateReadingRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted for async processing"
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "handlers.healthResponse": {
            "type": "object",
            "properties": {
                "nats": {
                    "type": "string"
                },
                "postgres": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "models.Alert": {
            "type": "object",
            "properties": {
                "actual_output": {
                    "type": "number"
                },
                "asset_id": {
                    "type": "string"
                },
                "deviation_pct": {
                    "description": "e.g. 0.35 means 35% below",
                    "type": "number"
                },
                "expected_output": {
                    "type": "number"
                },
                "id": {
                    "type": "string"
                },
                "triggered_at": {
                    "type": "string"
                }
            }
        },
        "models.Asset": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "expected_output": {
                    "description": "in kW",
                    "type": "number"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.CreateAssetRequest": {
            "type": "object",
            "properties": {
                "expected_output": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "models.CreateReadingRequest": {
            "type": "object",
            "properties": {
                "actual_output": {
                    "type": "number"
                },
                "asset_id": {
                    "type": "string"
                },
                "recorded_at": {
                    "type": "string"
                }
            }
        }
    }
}